# ==============================================================================
# Smart Disaster Alert & Resource Coordination System - Environment Variables
# Copy to .env or backend/.env — NEVER commit real production secrets to Git.
# ==============================================================================

# ── Server & Networking ────────────────────────────────────────────────────────
# Backend server port (Spring Boot default: 8080)
SERVER_PORT=8080

# Comma-separated allowed CORS origins for web clients
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Database ──────────────────────────────────────────────────────────────────
# MongoDB connection URI (Atlas cluster or local instance)
MONGODB_URI=mongodb://localhost:27017/disaster_db

# ── Authentication & Security ──────────────────────────────────────────────────
# Secret key for HMAC-SHA256 JWT signing (minimum 32 characters)
JWT_SECRET=disaster-platform-super-secret-key-change-in-production-min-32-chars

# ── Email Delivery (Brevo / Gmail) ────────────────────────────────────────────
# Active mail provider ('auto', 'brevo', or 'gmail')
MAIL_PROVIDER=auto

# SMTP Host (e.g. smtp-relay.brevo.com or smtp.gmail.com)
MAIL_HOST=smtp-relay.brevo.com

# SMTP Port (587 for STARTTLS)
MAIL_PORT=587

# SMTP authentication username
MAIL_USERNAME=your-email@example.com

# SMTP authentication password
MAIL_PASSWORD=your-email-app-password

# Outgoing "From" email address
MAIL_FROM=your-email@example.com

# Brevo (Sendinblue) Transactional API Key (v3)
BREVO_API_KEY=your_brevo_api_key_here

# Emergency SOS notification recipient authority email address
SOS_ALERT_EMAIL=central-emergency@disaster.local

# Legacy Gmail fallbacks (used when MAIL_USERNAME/MAIL_PASSWORD are not configured)
GMAIL_USER=your-email@example.com
GMAIL_APP_PASSWORD=your-email-app-password

# ── External Data Integrations (API Keys) ──────────────────────────────────────
# OpenWeatherMap API Key for live weather metrics
OPENWEATHER_API_KEY=your_openweather_api_key_here

# NASA FIRMS MAP_KEY for satellite fire detection feed
NASA_FIRMS_MAP_KEY=your_nasa_firms_map_key_here

# Google Maps / Places API Key for geocoding
GOOGLE_API_KEY=your_google_api_key_here

# Google Earth Engine microservice endpoint (default: http://localhost:5050)
GEE_SERVICE_URL=http://localhost:5050

# Automated periodic mock disaster event ingestion (true/false)
AUTO_INGEST=false

# ── SMS Alerts (Twilio) ───────────────────────────────────────────────────────
# Twilio Account SID
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here

# Twilio Auth Token
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here

# Twilio sender phone number (E.164 formatted)
TWILIO_PHONE_NUMBER=+1234567890

# ── SACHET NDMA RSS Integration (Python Service) ──────────────────────────────
# Official NDMA SACHET public RSS alert feed
SACHET_FEED_URL=https://sachet.ndma.gov.in/cap_public_website/rss/rss_india.xml

# Background feed polling interval in seconds
SACHET_POLL_INTERVAL_SECONDS=300

# Max alerts stored in cache/database
SACHET_MAX_STORED_ALERTS=500

# Enable background polling service (true/false)
SACHET_ENABLED=true

# Spring Boot target endpoint for posting newly ingested SACHET alerts
BACKEND_INGEST_URL=http://localhost:8080/api/events/ingest
