# Copy to .env (or backend/.env and frontend/.env) — never commit real secrets

# MongoDB Auth (used by docker-compose)
MONGO_INITDB_ROOT_USERNAME=app_user
MONGO_INITDB_ROOT_PASSWORD=generate-via-scripts-gen-secrets
MONGODB_URI=mongodb://app_user:generate-via-scripts-gen-secrets@localhost:27017/disaster_db?authSource=admin

SERVER_PORT=8080
JWT_SECRET=generate-via-scripts-gen-secrets
INGEST_API_KEY=generate-via-scripts-gen-secrets
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Development profile & credentials (only runs seeder when SPRING_PROFILES_ACTIVE=dev)
SPRING_PROFILES_ACTIVE=dev
DEV_ADMIN_PASSWORD=change-me-dev-admin-password
DEV_USER_PASSWORD=change-me-dev-user-password
DEV_ORG_PASSWORD=change-me-dev-org-password

# Email Delivery (Brevo SMTP recommended or custom SMTP)
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=your-email@example.com
MAIL_PASSWORD=your-email-app-password
MAIL_FROM=your-email@example.com

GMAIL_USER=your-email@example.com
GMAIL_APP_PASSWORD=your-email-app-password

OPENWEATHER_API_KEY=your_openweather_api_key_here
NASA_FIRMS_MAP_KEY=your_nasa_firms_map_key_here
GOOGLE_API_KEY=your_google_api_key_here

TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=your_twilio_phone_number_here

# ── SACHET NDMA Integration (no API key required — public RSS feed) ──────────
SACHET_FEED_URL=https://sachet.ndma.gov.in/cap_public_website/rss/rss_india.xml
SACHET_POLL_INTERVAL_SECONDS=300
SACHET_MAX_STORED_ALERTS=500
SACHET_ENABLED=true
BACKEND_INGEST_URL=http://localhost:8080/api/events/ingest
