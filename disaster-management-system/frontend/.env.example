# ==============================================================================
# Frontend Environment Configuration (.env)
# ==============================================================================

# Backend REST API base URL (Spring Boot server port 8080)
VITE_API_URL=http://localhost:8080

# Backend WebSocket STOMP endpoint URL (Spring Boot server port 8080)
VITE_WS_URL=http://localhost:8080

# Mapbox Public Access Token (optional, used for custom satellite/vector map tiles)
VITE_MAPBOX_TOKEN=your_mapbox_public_token
